{
  "name": "ansi-warhol",
  "version": "0.0.1",
  "description": "Convert images to Unicode text art (Browser + Node.js)",
  "keywords": [
    "ascii-art",
    "ansi",
    "unicode",
    "text-art",
    "image",
    "webgpu",
    "cli"
  ],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/texodus/ansi-warhol"
	},

  "type": "module",
  "main": "dist/ansi-warhol.esm.js",
  "module": "dist/ansi-warhol.esm.js",
  "exports": {
    ".": {
      "import": "./dist/ansi-warhol.esm.js",
      "default": "./dist/ansi-warhol.esm.js"
    }
  },
  "bin": {
    "ansi-warhol": "./bin/ansi-warhol"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "./bin/ansi-warhol",
    "serve": "npm exec serve dist",
    "deploy": "node deploy.mjs",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.24.0",
    "serve": "14.2.5"
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "pngjs": "^7.0.0"
  }
}
